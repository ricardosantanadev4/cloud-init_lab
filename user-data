
#cloud-config

# Atualiza a lista de pacotes antes das instalações
package_update: true
package_upgrade: false

# Cria um usuário administrador
users:
  - name: meu-usuario
    gecos: Usuario Administrador
    groups:
      - sudo
      - docker
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - COLE_AQUI_SUA_CHAVE_PUBLICA

# Instala os softwares declarativamente
packages:
  - docker.io
  - nginx

# Cria uma página personalizada
write_files:
  - path: /var/www/html/index.html
    owner: root:root
    permissions: '0644'
    content: |
      <!DOCTYPE html>
      <html lang="pt-BR">
      <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Laboratório Cloud-Init</title>
      </head>
      <body>
        <h1>Cloud-Init executado com sucesso!</h1>
        <p>Servidor configurado automaticamente com Docker e Nginx.</p>
        <p>Atividade prática de DevOps.</p>
      </body>
      </html>

# Executa comandos após as etapas de configuração
runcmd:
  - systemctl enable --now nginx
  - systemctl enable --now docker
  - usermod -aG docker meu-usuario

# Mensagem final registrada nos logs
final_message: "Configuracao concluida. Docker e Nginx configurados apos $UPTIME segundos."
